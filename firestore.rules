rules_version = '2';

// ============================================================================
// REGRAS DE SEGURANÇA — ESTOQUE+ (Mini-ERP)
// Cole este conteúdo em: Firebase Console > Firestore Database > Regras
//
// Papéis (role) armazenados em /users/{uid}:
//   admin     -> acesso total, incluindo gestão de usuários
//   gerente   -> gerencia produtos e movimentações, vê relatórios
//   operador  -> só registra movimentações e visualiza produtos
//   pendente  -> sem acesso, aguardando aprovação de um admin
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myProfile().role
        : 'pendente';
    }

    function isActive() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().active == true;
    }

    function isAdmin()    { return isActive() && myRole() == 'admin'; }
    function isGerente()  { return isActive() && (myRole() == 'gerente' || myRole() == 'admin'); }
    function isOperador() { return isActive() && (myRole() == 'operador' || myRole() == 'gerente' || myRole() == 'admin'); }

    // ---- users: qualquer usuário autenticado pode criar/ler o PRÓPRIO doc
    // no primeiro login; só admins podem alterar role/active de outros.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid
                      && request.resource.data.role == resource.data.role
                      && request.resource.data.active == resource.data.active);
      allow delete: if isAdmin();
    }

    // ---- meta/counters: usado internamente para decidir o primeiro admin
    match /meta/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---- products
    match /products/{id} {
      allow read: if isOperador();
      allow create, update: if isGerente();
      allow delete: if isAdmin();
    }

    // ---- movements (entradas e saídas)
    match /movements/{id} {
      allow read: if isOperador();
      allow create: if isOperador();
      allow update, delete: if isAdmin();
    }
  }
}
